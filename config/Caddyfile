# Remote access: Cloudflare Tunnel -> Caddy (basic auth) -> dongseon (127.0.0.1:8100).
# Values come from .env through scripts/caddy.sh; nothing personal lives in this file.
# HTTPS ends at Cloudflare. The tunnel's published route for DONGSEON_DOMAIN points at
# http://localhost:DONGSEON_PROXY_PORT; cloudflared keeps the original Host and no router port is forwarded.
{
	admin off
	auto_https off
	default_bind 127.0.0.1
}

http://{$DONGSEON_DOMAIN}:{$DONGSEON_PROXY_PORT} {
	basic_auth {
		{$DONGSEON_AUTH_USER} {$DONGSEON_AUTH_HASH}
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow"
		# The Google Maps JS key is restricted by HTTP referrer, so keep the default cross-origin policy.
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy 127.0.0.1:{$DONGSEON_PORT}

	log {
		output file {$DONGSEON_LOG_DIR}/caddy-access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# Any other Host (or a request straight to the port) gets nothing.
http://:{$DONGSEON_PROXY_PORT} {
	abort
}
