# Copy to .env and fill in. Never commit .env.

# Google Maps Platform (needs a Cloud project with a billing account)
# Server key. API restriction: Places API (New), Routes API
GOOGLE_MAPS_SERVER_KEY=
# Browser key. API restriction: Maps JavaScript API. HTTP referrer restriction: localhost:5174, remote domain
VITE_GOOGLE_MAPS_JS_KEY=
VITE_GOOGLE_MAP_ID=
# Share of each SKU's monthly free cap (config/defaults.yaml) at which to warn / block calls
GOOGLE_FREE_TIER_WARN_RATIO=0.8
GOOGLE_FREE_TIER_STOP_RATIO=1.0

# LLM (headless Claude Code on the user's subscription, same as jipsa). Empty model = Claude Code default
LLM_MODEL=
LLM_DAILY_TOKEN_LIMIT=500000

# Paths (relative paths resolve from the repo root)
DATABASE_PATH=data/dongseon.db
PROFILE_PATH=config/profile.yaml

# Ports (jipsa uses 8000 / 8001 / 5173)
DONGSEON_PORT=8100
DONGSEON_DEV_PORT=8101

# Remote access: Cloudflare Tunnel -> Caddy -> app (optional; see scripts/caddy.sh).
# Keep the domain out of tracked files. The tunnel connector can be shared with other apps on this Mac;
# add a published route DONGSEON_DOMAIN -> http://localhost:<DONGSEON_PROXY_PORT> in the Cloudflare dashboard.
DONGSEON_DOMAIN=
DONGSEON_AUTH_USER=
# bcrypt hash from `make remote-hash` (never the plain password); wrap it in single quotes
DONGSEON_AUTH_HASH=
# Loopback port Caddy listens on (jipsa's Caddy uses 8080)
DONGSEON_PROXY_PORT=8081
